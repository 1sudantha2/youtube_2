<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Compose draws every pixel, so the activity theme only has to provide a window
      background and disable the action bar. Keeping it minimal avoids inflating
      AppCompat view trees we never use.
    -->
    <style name="Theme.YouTube" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>

    <style name="Theme.YouTube.Splash" parent="Theme.YouTube">
        <item name="android:windowBackground">@color/black</item>
    </style>
</resources>
