<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      InnerTube and googlevideo.com are HTTPS-only. Cleartext stays disabled; the
      explicit domains are listed so a future proxy/debug build has a single place
      to change.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
