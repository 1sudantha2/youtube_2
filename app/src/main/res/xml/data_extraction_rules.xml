<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Session cookies and watch history must never end up in a cloud backup. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
